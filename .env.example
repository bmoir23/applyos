# App
NODE_ENV=development

# PostHog
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
NEXT_PUBLIC_POSTHOG_HOST=https://your-posthog-host

# Neon Postgres
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Firecrawl (optional; deterministic mock extraction is used when absent)
# FIRECRAWL_API_KEY=

# n8n — shared secret (legacy header) and HMAC signing for machine APIs
# N8N_WEBHOOK_SECRET=
# N8N_HMAC_SECRET=
# N8N_WEBHOOK_URL=https://your-n8n.example/webhook/applyos

# OpenAI-compatible chat provider (scoring, documents, classification)
# AI_PROVIDER=openai-compatible
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=
# Optional Cloudflare AI Gateway selector for chat
# AI_GATEWAY_ID=

# Cloudflare Workers AI embeddings (pgvector 768-dim)
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# EMBEDDING_MODEL=@cf/baai/bge-base-en-v1.5
# EMBEDDING_DIMENSIONS=768
# EMBEDDING_POOLING=cls
# Optional: route embeddings through AI Gateway
# AI_GATEWAY_ID=

# Email — separate inbound (CF Email Routing) and outbound (Resend) domains
# EMAIL_INBOUND_DOMAIN=inbound.applyos.me
# EMAIL_OUTBOUND_DOMAIN=mail.applyos.me
# EMAIL_WORKER_HMAC_SECRET=
# RESEND_API_KEY=
# RESEND_WEBHOOK_SECRET=

# Feature flags (comma-separated). Empty = all enabled in development.
# FEATURE_FLAGS=profile_ingestion,semantic_matching,kanban,inbox,tribes,hitl_workspace
